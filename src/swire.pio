.program swire_tx
.wrap_target
    out pins, 1         [3]
.wrap

.program swire_rx
.wrap_target
    pull block
    mov  x, osr
byteloop:
    set  y, 7
    set  pindirs, 1     [3]
    set  pindirs, 0
    wait 1 pin 0
bitloop:
    wait 0 pin 0
    nop                 [8]
    in   pins, 1
    jmp  pin, bit_is_zero
    wait 1 pin 0
bit_is_zero:
    jmp  y--, bitloop
    wait 0 pin 0
    wait 1 pin 0
    jmp  x--, byteloop
.wrap

% c-sdk {

static inline void swire_tx_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = pio_get_default_sm_config();
    sm_config_set_wrap(&c, offset, offset);
    sm_config_set_out_pins(&c, pin, 1);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_out_shift(&c, true, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    pio_sm_init(pio, sm, offset, &c);
}

static inline void swire_rx_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = swire_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&c, pin);
    sm_config_set_set_pins(&c, pin, 1);
    sm_config_set_jmp_pin(&c, pin);
    sm_config_set_in_shift(&c, false, true, 8);
    pio_sm_init(pio, sm, offset, &c);
}

%}
